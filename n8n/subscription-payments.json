{
  "name": "Rishi App — Subscription payments (success + failed)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "9a41c7f2-5d18-4c6e-9b30-8e7f21ab4d55",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "s1000000-0000-4000-8000-000000000001",
      "name": "Subscription webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -260,
        0
      ],
      "webhookId": "9a41c7f2-5d18-4c6e-9b30-8e7f21ab4d55",
      "notes": "Set the PRODUCTION url of this node as N8N_PAYMENT_WEBHOOK_URL in the Supabase edge function secrets. A /webhook-test/ url only exists while this editor tab is listening, which is how the course workflow silently received nothing for two rounds."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "s1000000-0000-4000-8000-000000000002-c",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "payment_success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "s1000000-0000-4000-8000-000000000002",
      "name": "Is success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ],
      "notes": "razorpay-webhook sends payment_success or payment_failed. content_type is 'subscription' here; the course workflow is a separate flow on a separate url."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s2000000-0000-4000-8000-000000000001",
              "name": "waNumber",
              "value": "={{ (($json.body.phone || '').trim().startsWith('+') ? ($json.body.phone || '').replace(/\\D/g, '') : ($json.body.phone || '').replace(/\\D/g, '').replace(/^(?!91)(\\d{10})$/, '91$1')) }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000002",
              "name": "firstName",
              "value": "={{ ($json.body.name || 'there').split(' ')[0] }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000003",
              "name": "planName",
              "value": "={{ $json.body.plan_name }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000004",
              "name": "amountLabel",
              "value": "={{ $json.body.currency === 'INR' ? '₹' + $json.body.amount : $json.body.currency + ' ' + $json.body.amount }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000005",
              "name": "buyerName",
              "value": "={{ $json.body.name || '' }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000006",
              "name": "buyerEmail",
              "value": "={{ $json.body.email || '' }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000007",
              "name": "buyerState",
              "value": "={{ $json.body.state || '' }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000008",
              "name": "amount",
              "value": "={{ $json.body.amount }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-000000000009",
              "name": "currency",
              "value": "={{ $json.body.currency }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-00000000000a",
              "name": "couponCode",
              "value": "={{ $json.body.coupon_code || '' }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-00000000000b",
              "name": "discountAmount",
              "value": "={{ $json.body.discount_amount || 0 }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-00000000000c",
              "name": "userId",
              "value": "={{ $json.body.user_id }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-00000000000d",
              "name": "eventType",
              "value": "={{ $json.body.event }}",
              "type": "string"
            },
            {
              "id": "s2000000-0000-4000-8000-00000000000e",
              "name": "paidAt",
              "value": "={{ $now.setZone('Asia/Kolkata').toFormat('yyyy-LL-dd HH:mm') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "s1000000-0000-4000-8000-000000000003",
      "name": "Normalise",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        -120
      ],
      "notes": "Phone is digits-only and prefixed 91 when it is a bare ten-digit Indian number — Wati rejects '+' and spaces. Every downstream node reads from here by name so a node inserted in between cannot change what Sheets logs."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://live-mt-server.wati.io/REPLACE_TENANT_ID/api/v1/sendTemplateMessage?whatsappNumber={{ $json.waNumber }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_WATI_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ template_name: 'subscription_purchase_success', broadcast_name: 'subscription_purchase_success', parameters: [ { name: '1', value: $json.firstName }, { name: '2', value: $json.amountLabel }, { name: '3', value: $json.planName } ] }) }}",
        "options": {}
      },
      "id": "s1000000-0000-4000-8000-000000000004",
      "name": "Wati: send confirmation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -120
      ],
      "notes": "Create this template in Wati with three variables: name, amount, plan. Its name here must match the approved template exactly or Wati answers 200 with an error body."
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Subscriptions",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Date": "={{ $('Normalise').item.json.paidAt }}",
            "Event": "={{ $('Normalise').item.json.eventType }}",
            "Name": "={{ $('Normalise').item.json.buyerName }}",
            "Email": "={{ $('Normalise').item.json.buyerEmail }}",
            "Phone": "={{ $('Normalise').item.json.waNumber }}",
            "State": "={{ $('Normalise').item.json.buyerState }}",
            "Plan": "={{ $('Normalise').item.json.planName }}",
            "Amount": "={{ $('Normalise').item.json.amount }}",
            "Currency": "={{ $('Normalise').item.json.currency }}",
            "Coupon": "={{ $('Normalise').item.json.couponCode }}",
            "Discount": "={{ $('Normalise').item.json.discountAmount }}",
            "Reason": "={{ '' }}",
            "User ID": "={{ $('Normalise').item.json.userId }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "s1000000-0000-4000-8000-000000000005",
      "name": "Log subscription to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        700,
        -120
      ],
      "notes": "Successes and failures share one Subscriptions tab, so the whole story of a subscriber sits in one place in the order it happened. The Event column separates them. Columns that only one branch fills (Discount on a success, Reason on a failure) are still mapped, to an empty string — an unmapped column leaves its cell unwritten, and a later append can then land values one column across. Mapping is explicit, NOT 'Map Automatically': left automatic this logs whatever Wati returned instead of the payment, which is what happened on the course workflow."
    },
