              "value": "={{ $json.body.discount_amount || 0 }}",
              "type": "number"
            },
            {
              "id": "f1000000-0000-4000-8000-00000000000c",
              "name": "userId",
              "value": "={{ $json.body.user_id }}",
              "type": "string"
            },
            {
              "id": "f1000000-0000-4000-8000-00000000000d",
