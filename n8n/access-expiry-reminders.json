        },
        "options": {}
      },
      "id": "e1000000-0000-4000-8000-000000000008",
      "name": "Log reminder (expiring)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        680,
        140
      ],
      "notes": "Both branches write every column in the Renewals tab; the ones this branch has no value for are mapped to an empty string rather than left out. An unmapped column leaves its cell unwritten, and a later append can then land its values one column across — corrupting the sheet quietly instead of failing."
    }
