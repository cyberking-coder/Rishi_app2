{
  "name": "Rishi App — Live session reminders (cron)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://gzcanqovqirarnculqjq.supabase.co/functions/v1/send-session-reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_SUPABASE_SERVICE_ROLE_KEY"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Send due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "notes": "The function decides what is due. This node only has to call it — no scheduling logic here, so 'when does a reminder fire' has one answer in one place (due_session_reminders in the database). A non-200 fails the execution, which is what turns it red in the executions list; there is no error branch because that list is already the alarm."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Send due reminders", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
