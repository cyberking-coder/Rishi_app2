      "typeVersion": 2,
      "position": [
        -20,
        0
      ],
      "notes": "razorpay-webhook sends payment_success or payment_failed. content_type is 'workshop' here — courses and the membership are separate flows on separate urls."
    },
    {
      "parameters": {
        "assignments": {
