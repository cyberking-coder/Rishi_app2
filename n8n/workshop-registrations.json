      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        -120
      ],
      "notes": "Create this template in Wati with three variables: name, workshop, amount. The name here must match the approved template exactly or Wati answers 200 with an error body."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://live-mt-server.wati.io/REPLACE_TENANT_ID/api/v1/sendTemplateMessage?whatsappNumber={{ $json.waNumber }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_WATI_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ template_name: 'workshop_payment_failed', broadcast_name: 'workshop_payment_failed', parameters: [ { name: '1', value: $json.firstName }, { name: '2', value: $json.workshopName }, { name: '3', value: $json.reason } ] }) }}",
        "options": {}
      },
      "id": "w1000000-0000-4000-8000-000000000006",
      "name": "Wati: send failure notice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        120
      ],
      "notes": "Three variables: name, workshop, reason. A failed payment means no seat was held — the message has to say so plainly, or somebody turns up on the day."
    },
