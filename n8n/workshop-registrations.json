    {
      "parameters": {
        "method": "POST",
        "url": "=https://live-mt-server.wati.io/REPLACE_TENANT_ID/api/v1/sendTemplateMessage?whatsappNumber={{ $json.waNumber }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer REPLACE_WITH_WATI_TOKEN"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ template_name: 'workshop_registration_success', broadcast_name: 'workshop_registration_success', parameters: [ { name: '1', value: $json.firstName }, { name: '2', value: $json.workshopName }, { name: '3', value: $json.amountLabel } ] }) }}",
        "options": {}
      },
