      "notes": "Set the PRODUCTION url of this node as N8N_WORKSHOP_WEBHOOK_URL in the Supabase edge function secrets, then redeploy razorpay-webhook. A /webhook-test/ url only exists while this editor tab is listening, which is how earlier workflows silently received nothing for two rounds. Remember to ACTIVATE the workflow: an inactive one fires nothing and says nothing."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "w1000000-0000-4000-8000-000000000002-c",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "payment_success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w1000000-0000-4000-8000-000000000002",
      "name": "Is success?",
