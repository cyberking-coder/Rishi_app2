<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (fullBackupContent). Exclude flutter_secure_storage's
  EncryptedSharedPreferences from Auto Backup. Its AES keys are wrapped by a
  non-exportable Android Keystore key that CANNOT be backed up, so restoring
  the encrypted prefs to a new device leaves undecryptable blobs and crashes
  reads with BadPaddingException / BAD_DECRYPT. Excluding the file means a
  migrated device simply has no stored download keys and re-downloads cleanly.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <!--
      The Supabase auth session lives in plain SharedPreferences
      (FlutterSharedPreferences.xml), NOT in flutter_secure_storage. If Auto
      Backup restores it to a fresh install, the app comes back "logged in"
      with a stale session and no registered device — no login screen, Profile
      says "Not logged in", and playback fails. A reinstall must restore NO
      identity, so the whole prefs file is excluded (other prefs like theme
      simply re-default, which is harmless).
    -->
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    <!--
      The app-owned login flag (legacy LoginFlagStore, a plain file). Same
      reasoning — must not be restored to a fresh install.
    -->
    <exclude domain="file" path="login_flag"/>
</full-backup-content>
