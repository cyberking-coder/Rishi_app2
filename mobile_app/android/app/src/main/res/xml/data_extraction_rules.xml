<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (dataExtractionRules). Same reasoning as backup_rules.xml, for
  both cloud backup AND device-to-device transfer: flutter_secure_storage's
  EncryptedSharedPreferences is excluded because its wrapping key lives in the
  Android Keystore and never travels with a backup/transfer, so a restored
  copy is undecryptable and crashes reads (BAD_DECRYPT). Excluded here, a new
  device just re-downloads instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <!-- The Supabase session lives here; restoring it to a fresh install
             is what made a reinstall come back "logged in" with a stale
             session and no device. See backup_rules.xml. -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <!-- Legacy login flag — must not be restored either. -->
        <exclude domain="file" path="login_flag"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="login_flag"/>
    </device-transfer>
</data-extraction-rules>
