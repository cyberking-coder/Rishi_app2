<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple. Required by App Store Guideline 4.8 because
	     the app offers Google Sign-In.

	     This file existing is not enough on its own. Two more things must
	     be true or the button fails at runtime with an unhelpful
	     authorization error:

	       1. The Xcode target must reference it. Open Runner.xcworkspace,
	          select the Runner target, Signing & Capabilities, and add
	          "Sign in with Apple". Xcode wires CODE_SIGN_ENTITLEMENTS to
	          this file. Doing it in Xcode rather than by hand-editing
	          project.pbxproj is deliberate — that file is easy to corrupt
	          and hard to review.

	       2. The App ID in the Apple Developer portal must have the Sign
	          in with Apple capability enabled, and the provisioning
	          profile must be regenerated afterwards. Codemagic fetches a
	          fresh profile on every build, so it picks this up on its own
	          once the App ID is updated.

	     Supabase also needs its Apple provider configured (Services ID,
	     Team ID, Key ID and the .p8 key) or the token exchange fails
	     after Apple has already shown its sheet — which looks to the user
	     like the app broke at the last step. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
